# Port
PORT=your_port

# MongoDB URL
MONGO_URI=mongodb+srv://<db_username>:<db_password>@name.mongodb.net/?appName=todo

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloudinary_name
CLOUDINARY_API_KEY=cloudinary_api_key
CLOUDINARY_API_SECRET=cloudinary_api_secret

# JWT secret key
JWT_SECRET=your_jwt_secret

# Node environment
NODE_ENV=production

# Frontend URL (allowed by CORS in addition to localhost:5173/5174)
FRONTEND_URL=http://localhost:5173